# Moderators of the keynote comments (owner decision 2026-11-24: the owner only). Not in git: this repo is public.
# Create the Secret once, from a local file with the real address (verified at auth.sent-tech.ca):
#   cp deploy/keynote-comments/admin.env.example /tmp/keynote-comments.admin.env && chmod 600 /tmp/keynote-comments.admin.env
#   (edit ADMIN_EMAILS, then)
#   kubectl -n sentropic create secret generic keynote-comments-admin --from-env-file=/tmp/keynote-comments.admin.env
# Writing a comment also needs an e-mail verified by the IdP (reading stays open to any signed-in account).
ADMIN_EMAILS=<owner e-mail, verified at auth.sent-tech.ca>
