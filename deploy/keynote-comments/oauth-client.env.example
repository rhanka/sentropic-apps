# OIDC client of the comments service at auth.sent-tech.ca. PUBLIC client (PKCE, no secret): nothing here is secret.
# Register with the governed wrapper of rhanka/sentropic (prod IdP database, owner approval):
#   cp deploy/keynote-comments/oauth-client.env.example /tmp/keynote-comments.oauth.env && chmod 600 /tmp/keynote-comments.oauth.env
#   make -C ~/src/sentropic oauth-register-client-job SECRET_FILE=/tmp/keynote-comments.oauth.env ENV=<env>
# The first redirect URI is the sign-in callback; the second is where the IdP sends the browser back after sign-out
# (end_session only redirects to a registered URI). Both must match the service's PUBLIC_URL exactly.
OAUTH_CLIENT_ID=keynote-comments
OAUTH_CLIENT_NAME=Keynote comments (dev-mtl 2026)
OAUTH_CLIENT_REDIRECT_URIS=https://comments.sent-tech.ca/auth/oauth/callback,https://comments.sent-tech.ca/auth/logout/done
OAUTH_CLIENT_TOKEN_AUTH=none
OAUTH_CLIENT_SCOPES=openid,profile,email
OAUTH_CLIENT_GRANT_TYPES=authorization_code
# Any account of the IdP may sign in (no tenant membership required), as for design-system.
OAUTH_CLIENT_REQUIRE_TENANT=false
