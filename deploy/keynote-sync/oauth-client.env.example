# OIDC client of the sync service. PUBLIC client (PKCE, no secret). Nothing here is secret.
OAUTH_CLIENT_ID=keynote-sync
OAUTH_CLIENT_NAME=Keynote sync (dev-mtl 2026)
OAUTH_CLIENT_REDIRECT_URIS=https://sync.sent-tech.ca/auth/oauth/callback,https://sync.sent-tech.ca/auth/logout/done
OAUTH_CLIENT_TOKEN_AUTH=none
OAUTH_CLIENT_SCOPES=openid,profile,email
OAUTH_CLIENT_GRANT_TYPES=authorization_code
OAUTH_CLIENT_REQUIRE_TENANT=false
